{
  "name": "ratchet-companion",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-dev-ports.mjs && npm --prefix ui run dev",
    "dev:ui": "npm --prefix ui run dev",
    "dev:backend": "dotnet run --project lib/src/RatchetCompanion.Host/RatchetCompanion.Host.csproj",
    "build": "npm run build:backend && npm run build:ui && npm run build:electron",
    "build:all": "npm run build:linux && npm run build:windows",
    "build:ui": "npm --prefix ui run build",
    "build:electron": "npm --prefix ui run build:electron",
    "build:backend": "dotnet build lib/RatchetCompanion.sln",
    "build:linux": "node scripts/build-linux.mjs",
    "build:linux:framework": "node scripts/build-linux.mjs --framework-dependent",
    "build:windows": "node scripts/build-windows.mjs",
    "build:windows:framework": "node scripts/build-windows.mjs --framework-dependent"
  }
}